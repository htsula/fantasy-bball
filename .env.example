# Postgres connection string (Neon in production, e.g. from the Vercel Marketplace integration).
# Leave unset (or use "pglite:./.pglite") for local dev: an embedded PGlite database, no install needed.
DATABASE_URL=

# Shared secret for /api/cron/* routes. Vercel Cron sends it as "Authorization: Bearer <secret>".
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# Public base URL used when generating invite / reset links (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Only read by `npm run create-admin` (prompted for if unset). Do not set in production env.
# ADMIN_PASSWORD=
